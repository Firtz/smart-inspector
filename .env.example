# Smart Inspector Environment Variables Example
# Copy this file to .env and adjust values as needed for your host or Raspberry Pi 5.

# Path to main system configuration
SMART_INSPECTOR_SETTINGS_PATH=config/settings.yaml

# Path to AI model registry configuration
SMART_INSPECTOR_MODELS_PATH=config/models.yaml

# Override runtime mode: "mock" (safe default for dev without model files) or "real"
SMART_INSPECTOR_RUNTIME_MODE=mock

# Override execution mode: "sequential" or "parallel"
SMART_INSPECTOR_EXECUTION_MODE=sequential

# Override ROS 2 publishing enable flag ("true" or "false")
SMART_INSPECTOR_ROS2_ENABLED=false

# Local API host and port overrides
SMART_INSPECTOR_API_HOST=0.0.0.0
SMART_INSPECTOR_API_PORT=8000

# Logging level (DEBUG, INFO, WARNING, ERROR)
SMART_INSPECTOR_LOG_LEVEL=INFO

